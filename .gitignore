# ==========================================
# HOSPITAL OP PORTAL - GITIGNORE CONFIGURATION
# ==========================================

# 1. Sensitive Files & Secrets (NEVER COMMIT TO GITHUB)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# 2. Dependency Directories
node_modules/
frontend/node_modules/
backend/node_modules/
.pnp
.pnp.js

# 3. Production & Build Outputs
dist/
build/
out/
frontend/dist/
frontend/build/
frontend/.vite/
.vite/

# 4. Android Build Files & Keystores (Capacitor)
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/app/release/
*.apk
*.aab
*.keystore
*.jks

# 5. Database & Local Storage Files
*.db
*.sqlite
*.sqlite3
mongo-data/

# 6. Log Files & Crash Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. Operating System & Editor Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
