{
  "appId": "in.gov.mediop.app",
  "appName": "MediOP",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "buildOptions": {
      "keystorePath": "release-key.keystore",
      "keystoreAlias": "mediop"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0b1120",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
